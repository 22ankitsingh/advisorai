# ─────────────────────────────────────────────────────────────────────────────
# Advisor AI — Environment Variables Template
#
# Usage:
#   1. Copy this file:   copy .env.example .env      (Windows)
#                        cp .env.example .env         (Mac/Linux)
#   2. Fill in your values below
#   3. NEVER commit your .env file to version control
#
# Get a FREE Gemini API key: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini API ────────────────────────────────────────────────────────────────
# Required for AI chat features
GEMINI_API_KEY=your_gemini_api_key_here


# Gemini model name (free tier options: gemini-1.5-flash | gemini-1.5-pro)
# gemini-1.5-flash  → fastest, lowest cost, recommended for dev
# gemini-1.5-pro    → more capable, higher quota cost
GEMINI_MODEL=gemini-2.5-flash

# ── Gemini Generation Parameters ─────────────────────────────────────────────
# Controls how creative/deterministic the AI responses are (0.0 = deterministic, 1.0 = creative)
GEMINI_TEMPERATURE=0.7

# Maximum number of tokens in each AI response
GEMINI_MAX_TOKENS=2048

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Advisor AI
APP_ENV=development          # development | production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=data/advisor_ai.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
