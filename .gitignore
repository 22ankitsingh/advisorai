# ─────────────────────────────────────────────────────────────────────────────
# Advisor AI — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── NEVER commit these ────────────────────────────────────────────────────────
.env                        # API keys — copy from .env.example

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
*.egg-link
pip-wheel-metadata/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.virtualenv/

# ── Data & generated files ────────────────────────────────────────────────────
data/advisor_ai.db          # SQLite database (regenerated by seed.py)
data/chroma/                # ChromaDB vector store (regenerated on upload)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
logs/*.log
logs/*.jsonl

# ── Model cache (sentence-transformers downloads here) ────────────────────────
.cache/
~/.cache/

# ── OS & editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# ── Docker ───────────────────────────────────────────────────────────────────
# docker-compose.override.yml  # Uncomment if you add local overrides

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml     # If you migrate to Streamlit secrets
